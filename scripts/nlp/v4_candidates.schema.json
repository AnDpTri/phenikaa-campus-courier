{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "batch_id", "banks"],
  "properties": {
    "version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "banks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "VIA_FRAMES_BEFORE": {"$ref": "#/$defs/phrases"},
        "VIA_FRAMES_AFTER": {"$ref": "#/$defs/phrases"},
        "ANCHOR_NEAR_FRAMES": {"$ref": "#/$defs/phrases"},
        "GOAL_FRAMES": {"$ref": "#/$defs/phrases"},
        "DISTRACTOR_FRAMES": {"$ref": "#/$defs/phrases"},
        "REDIRECT_PREFIX": {"$ref": "#/$defs/phrases"},
        "MOST_PHRASES": {"$ref": "#/$defs/directions"},
        "EXTRA_PLACES": {"$ref": "#/$defs/placeTypes"},
        "EXTRA_PERSONS": {"$ref": "#/$defs/placeTypes"}
      }
    }
  },
  "$defs": {
    "phrases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 180},
      "uniqueItems": true
    },
    "directions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "north_most": {"$ref": "#/$defs/phrases"},
        "south_most": {"$ref": "#/$defs/phrases"},
        "west_most": {"$ref": "#/$defs/phrases"},
        "east_most": {"$ref": "#/$defs/phrases"}
      }
    },
    "placeTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "library": {"$ref": "#/$defs/phrases"},
        "dorm": {"$ref": "#/$defs/phrases"},
        "sports": {"$ref": "#/$defs/phrases"},
        "clinic": {"$ref": "#/$defs/phrases"},
        "canteen": {"$ref": "#/$defs/phrases"},
        "parking": {"$ref": "#/$defs/phrases"},
        "lecture": {"$ref": "#/$defs/phrases"},
        "lab": {"$ref": "#/$defs/phrases"},
        "office": {"$ref": "#/$defs/phrases"},
        "gate": {"$ref": "#/$defs/phrases"}
      }
    }
  }
}
